# Uploaded public media only. Nothing in here may ever be executed.
Options -Indexes -ExecCGI
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .pl .py .cgi .sh
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phar

<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

# Only image files written by the application are served.
<FilesMatch ".+">
    Require all denied
</FilesMatch>
<FilesMatch "^[a-f0-9]{32}(-thumb|-md)?\.(webp|jpg)$">
    Require all granted
</FilesMatch>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set Content-Security-Policy "default-src 'none'; img-src 'self'; style-src 'none'; sandbox"
    # One day: long enough for fast repeat visits, short enough that a withdrawn photo
    # leaves browser caches quickly (its file is also renamed when it is unpublished).
    Header set Cache-Control "public, max-age=86400"
</IfModule>
