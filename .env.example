# Copy this file to .env and fill in real values on the server.
# Never commit .env or share it. Values below are placeholders only.

# production | staging | local | testing
APP_ENV=production
# Must stay false in production (it is forced off there regardless).
APP_DEBUG=false
APP_URL=https://www.ritfoundationglobal.com
# Generate with: php scripts/generate-key.php
APP_KEY=REPLACE_ME
APP_FORCE_HTTPS=true
# Full-page cache for anonymous visitors (default: on in production). Set false to disable.
PAGE_CACHE=true
# Set to false to keep a production-mode staging copy out of search engines.
APP_INDEXABLE=true

# Database: use a dedicated user with only SELECT, INSERT, UPDATE, DELETE on this database.
DB_HOST=localhost
DB_PORT=3306
DB_SOCKET=
DB_NAME=REPLACE_ME
DB_USER=REPLACE_ME
DB_PASS=REPLACE_ME

SESSION_NAME=rit_session
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=8

UPLOAD_IMAGE_MAX_MB=8
UPLOAD_DOCUMENT_MAX_MB=5

# Email: none | log | mail | smtp  (see README "Email")
MAIL_DRIVER=none
MAIL_HOST=
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="RIT Foundation Ghana"
MAIL_ADMIN_ADDRESS=

# Payments: no provider has been chosen. Leave as "none" until one is integrated.
PAYMENT_PROVIDER=none
PAYMENT_PUBLIC_KEY=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# Optional one-time browser setup for the first administrator (min. 32 random characters).
# Leave blank to use the command-line script instead. Remove it after setup.
SETUP_TOKEN=

# Comma-separated proxy IPs whose X-Forwarded-For header may be trusted (e.g. a load balancer).
TRUSTED_PROXIES=

# Data retention used by scripts/purge-old-records.php
RETENTION_SUBMISSION_MONTHS=24
RETENTION_AUDIT_MONTHS=24
